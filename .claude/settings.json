{
  "model": "claude-opus-5-5",
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "low",
      "autoCompactWindow": 100000
    }
  },
  "permissions": {
    "allow": [
      "Bash(python3 tools/rpg.py:*)",
      "Read(campanha/**)",
      "Edit(campanha/resumo.md)",
      "Edit(campanha/prep.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/rpg.py\" boot" }
        ]
      }
    ]
  }
}
